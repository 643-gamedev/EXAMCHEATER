# Copy this file to .env and edit as needed.

PORT=3000

# Change this before putting the app anywhere near the internet.
JWT_SECRET=change_this_secret_before_deploying

# Local, free, open-source AI via Ollama (https://ollama.com)
# Works fully offline once the model is pulled.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# Excel-based user store (swap for Supabase/Firebase later — see README).
USERS_FILE=./data/users.xlsx
